# DPM package spec file
# Used to build packages

min client version: 1.0
# metadata describes the package to the user
metadata:
  id: VSoft.SemanticVersion
  authors: [Vincent Parrett]
  description: SemanticVersion Parser
  projectUrl: https://github.com/VSoftTechnologies/VSoft.SemanticVersion
  repositoryUrl: https://github.com/VSoftTechnologies/VSoft.SemanticVersion
  license: Apache-2.0
  readme: README.md
  copyright: Vincent Parrett and contributors
  tags: [SemanticVersion, Semver, parser]
  version: 0.3.0
  repositoryCommit: #HASH#

# define variable defaults - can be overriden in targetPlatforms
variables:
  packageSource: "Rad Studio $compilernoprefix$"

targetPlatforms:
  - compiler from: delphixe2
    compiler to: delphi13.0
    platforms: [win32, win64]

templates:
  - name: default
    source:
      - src: ./LICENSE.txt
      - src: ./source/*.pas
      - src: ./packages/$packageSource$/*.dpk
      - src: ./packages/$packageSource$/*.dproj
    build:
      - project: ./packages/$packageSource$/VSoft.SemanticVersionR.dproj
